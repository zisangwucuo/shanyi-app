# Server-only secrets. Use provider API root including /v1 if required.
SHANYI_VISION_BASE_URL=
SHANYI_VISION_API_KEY=
SHANYI_VISION_MODEL=
SHANYI_STYLIST_BASE_URL=
SHANYI_STYLIST_API_KEY=
SHANYI_STYLIST_MODEL=
# HTTPS multi-image /images/edits provider returning b64_json
SHANYI_TRYON_BASE_URL=
SHANYI_TRYON_API_KEY=
SHANYI_TRYON_MODEL=

# ── 登录认证 ────────────────────────────────────────────────
# development：本地固定验证码 123456，绝不能用于公网
# production：腾讯云短信真实验证码，需填齐下面的 TENCENT_SMS_* 与 SHANYI_OTP_SECRET
SHANYI_AUTH_MODE=development

# 生产模式必填：至少 32 字节，用于 HMAC 校验验证码，数据库不存明文
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 轮换后已发送但未使用的验证码立即失效
SHANYI_OTP_SECRET=

# 腾讯云短信 https://console.cloud.tencent.com/smsv2
# 子账号密钥建议只授予 QcloudSMSFullAccess，不要使用主账号密钥
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 模板变量顺序，只能是 code / code,minutes / minutes,code 之一
TENCENT_SMS_TEMPLATE_PARAMS=code

# 生产环境 Web 版的跨域来源（必须是 HTTPS，逗号分隔）；App 不需要
SHANYI_CORS_ORIGINS=
